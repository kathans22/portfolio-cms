{
  "name": "portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "predev": "npm run build:packages",
    "build:packages": "npm run build --workspace=packages/shared --workspace=packages/types",
    "build": "npm run build:packages && npm run build --workspace=apps/client --workspace=apps/server",
    "db:seed": "npm run db:seed --workspace=apps/server",
    "db:indexes": "npm run db:indexes --workspace=apps/server --",
    "db:backfill-pages": "npm run db:backfill-pages --workspace=apps/server --",
    "pretest": "npm run build:packages",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "pretypecheck": "npm run build:packages",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0"
  }
}
