# API base URL the client calls. Defaults to http://localhost:5000/api/v1 for local dev
# if unset — only required in production (see DEPLOYMENT_CHECKLIST.md).
VITE_API_URL="http://localhost:5000/api/v1"

# The deployed frontend's own URL. Used only at build time by scripts/generateSitemap.mjs
# to generate sitemap.xml / robots.txt. Leave unset locally — sitemap generation is
# skipped gracefully when it's missing, which is fine for dev.
VITE_SITE_URL=""
