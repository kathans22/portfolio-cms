# MongoDB Database (local: mongodb://localhost:27017/portfolio, Atlas free M0 cluster:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio — from the Atlas
# dashboard's "Connect" button after creating a database user)
 MONGODB_URI="mongodb://localhost:27017/portfolio"


# Express Port
PORT=5000

# Set to "production" when deployed (Render sets this automatically on most plans,
# but confirm it's present) — controls cookie SameSite/Secure behavior below, seed.ts's
# production guard, and Sentry's environment tag. Leave unset for local dev.
NODE_ENV="development"

# Allowed CORS origin(s) for the deployed/local frontend, comma-separated.
# In production, set this to your exact deployed frontend URL only (e.g.
# https://yourportfolio.vercel.app) — a wildcard or wrong domain here will make the
# admin CMS's cross-domain cookies fail silently.
CLIENT_ORIGIN="http://localhost:3000,http://localhost:3001"

# Auth Token Secrets
JWT_ACCESS_SECRET="your_jwt_access_token_secret_key"
JWT_REFRESH_SECRET="your_jwt_refresh_token_secret_key"
# Refresh token lifetime in days, clamped server-side to the 7-30 range
REFRESH_TOKEN_TTL_DAYS=7

# Seed admin account (used only by src/seed.ts to create/update the one Admin document)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_this_before_seeding"
ADMIN_NAME="Admin"

# Cloudinary Media Assets (Optional, falls back to local static directory /uploads/ if empty).
# NOTE: resume PDFs also go here. New Cloudinary accounts block PDF delivery by default —
# if a resume link returns 401/403, enable Settings > Security > "Allow delivery of PDF
# and ZIP files". On a host with an ephemeral filesystem (Render free tier), set these so
# uploaded resumes survive a restart.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend Notifier (Optional, falls back to SMTP then CLI logs if empty)
RESEND_API_KEY=""

# SMTP Credentials (Alternative to Resend)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# Contact receiver inbox
CONTACT_RECEIVER_EMAIL="admin@portfolio.com"

# Sentry error tracking (Optional — free tier is enough for a personal project. Create
# a project at sentry.io, copy its DSN here. Leave empty to disable error tracking
# entirely — the app runs fine without it, it just won't report exceptions anywhere.)
SENTRY_DSN=""

# Pino log verbosity: trace | debug | info | warn | error | fatal. "info" is a sane
# default; use "debug" locally if you need more detail while developing.
LOG_LEVEL="info"

# The PUBLIC site origin (the Vercel domain, not this API's). Used by
# GET /api/v1/sitemap.xml to write absolute <loc> URLs — a sitemap advertises the
# site's own URLs, so pointing this at the API would publish unusable links.
# Without it that endpoint returns 503 rather than emitting a wrong domain.
SITE_URL="http://localhost:3000"
